---
import Entry from "../components/Entry.astro";

const markup = `<span data-mark="box">demo<svg viewBox="0 0 100 100" preserveAspectRatio="none"
  aria-hidden="true" focusable="false"><path d="M4 8 C 30 5, …" /></svg></span>`;
const box = "M4 8 C 30 5, 70 4, 97 6 C 96 36, 97 66, 95 95 C 66 97, 33 96, 5 94 C 4 64, 3 36, 6 4";
const rows = [
  ["Una voce è pronta quando ha la sua ", "demo", "."],
  ["Il peso si legge in ", "byte", ", compresso, senza le librerie."],
  ["Lo stato passa da src a port, poi a ", "demo", "."],
];
---

<Entry
  id="mark-box"
  markup={markup}
  look="Il riquadro viene ridisegnato alla misura della parola, gli angoli che sforano, e tracciato in un tratto solo."
  attributes={[{ name: "data-mark-delay", value: "0.4", what: "Seconds to wait once it's on screen." }]}
>
  <section class="mb">
    <div class="wrap mb-block">
      {
        rows.map(([before, word, after]) => (
          <p class="mb-text">
            {before}
            <span data-mark="box">{word}<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={box} /></svg></span>{after}
          </p>
        ))
      }
    </div>
  </section>
</Entry>

<style>
  .mb {
    padding-block: clamp(120px, 20vh, 220px) clamp(160px, 26vh, 280px);
  }
  .mb-block {
    display: grid;
    gap: clamp(36px, 6vh, 64px);
  }
  .mb-text {
    margin: 0;
    max-width: 22em;
    font-family: var(--display);
    font-size: clamp(26px, 3.2vw, 46px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
</style>
