---
import Entry from "../components/Entry.astro";

const markup = `<ul data-alternate>
  <li>…</li> <!-- from the left -->
  <li>…</li> <!-- from the right -->
</ul>`;

const rows = [
  ["Core", "Lo scheletro: il ciclo di vita della pagina, Lenis, lo scroll, le guardie. Si copia una volta per sito."],
  ["Tier 1", "Le primitive: un attributo su un elemento, o una funzione. Titoli, rivelazioni, la penna, lo scroll, il puntatore."],
  ["Tier 2", "Le scene: una sezione con il suo contratto di markup, riusabile così com'è."],
  ["Tier 3", "Le ricette: il lavoro su misura, tenuto per imparare a fare il prossimo."],
];
---

<Entry
  id="alternate"
  markup={markup}
  look="Le righe entrano da lati alterni: la prima da sinistra, la seconda da destra, a lotti mentre arrivano."
>
  <section class="al">
    <div class="wrap">
      <ul class="al-rows" data-alternate>
        {
          rows.map(([name, text]) => (
            <li class="al-row">
              <h3>{name}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Entry>

<style>
  .al {
    padding-block: clamp(120px, 20vh, 220px);
  }
  .al-rows {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .al-row {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(16px, 4vw, 56px);
    align-items: baseline;
    padding-block: clamp(22px, 3vw, 36px);
    border-bottom: 1px solid var(--ink);
  }
  .al-row h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(26px, 3vw, 44px);
    line-height: 1;
  }
  .al-row p {
    margin: 0;
    max-width: 36em;
    color: var(--mute-2);
    line-height: 1.55;
  }
  @media (max-width: 640px) {
    .al-row {
      grid-template-columns: 1fr;
    }
  }
</style>
