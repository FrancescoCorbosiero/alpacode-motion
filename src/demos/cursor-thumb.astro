---
import Entry from "../components/Entry.astro";
import { site } from "./_shared/plates";

const markup = `<div class="index">  <!-- position: relative: the frame is placed from here -->
  <ol data-cursor-thumb>
    <li data-cursor-thumb-row data-cursor-thumb-label="falegnameria.it">
      <a href="…">Una falegnameria
        <span data-cursor-thumb-pic><img src="…" alt="" /></span>
      </a>
    </li>
    …
  </ol>
  <div data-cursor-thumb-frame hidden aria-hidden="true">
    <span data-cursor-thumb-bar></span>
    <div data-cursor-thumb-slot></div>
  </div>
</div>`;

const rows = [
  { name: "Una falegnameria", kind: "Sito vetrina", where: "Brianza", label: "la-falegnameria" },
  { name: "Una libreria", kind: "E-commerce", where: "Bologna", label: "la-libreria" },
  { name: "Uno studio legale", kind: "Sito aziendale", where: "Milano", label: "lo-studio" },
  { name: "Una palestra", kind: "Prenotazioni", where: "Monza", label: "la-palestra" },
  { name: "Un negozio di dischi", kind: "E-commerce", where: "Torino", label: "i-dischi" },
  { name: "Una cantina", kind: "Sito vetrina", where: "Langhe", label: "la-cantina" },
];
---

<Entry
  id="cursor-thumb"
  markup={markup}
  look="Col mouse sopra l'elenco: la cornice segue il puntatore, si piega con la sua velocità e ogni riga fa entrare la sua immagine dal lato da cui arrivi. Vicino al bordo destro passa a sinistra."
  attributes={[
    { name: "data-cursor-thumb-label", value: "testo", what: "What the frame's bar reads for this row (the site's address, or its name)." },
    { name: "data-cursor-thumb-vt", value: "work-…", what: "The view-transition name the row's picture carries: on click it moves to the frame, which grows into the next page." },
  ]}
>
  <section class="ct">
    <div class="wrap ct-index">
      <ol class="ct-list" data-cursor-thumb>
        {
          rows.map((r, i) => (
            <li class="ct-row" data-cursor-thumb-row data-cursor-thumb-label={r.label}>
              <a class="ct-link" href="#live">
                <span class="ct-no">{String(i + 1).padStart(2, "0")}</span>
                <span class="ct-name">{r.name}</span>
                <span class="ct-meta">
                  {r.kind} · {r.where}
                </span>
                <span class="ct-pic" data-cursor-thumb-pic>
                  <img src={site(31 + i * 7)} alt="" width="1440" height="900" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="ct-frame" data-cursor-thumb-frame hidden aria-hidden="true">
        <span class="ct-bar" data-cursor-thumb-bar></span>
        <div class="ct-view" data-cursor-thumb-slot></div>
      </div>
    </div>
  </section>
</Entry>

<style>
  .ct {
    padding-block: clamp(96px, 16vh, 180px);
  }
  .ct-index {
    position: relative;
  }
  .ct-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .ct-row {
    border-bottom: 1px solid var(--rule);
  }
  .ct-link {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto 128px;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    color: var(--ink);
    text-decoration: none;
  }
  .ct-no {
    font-size: 13px;
    font-weight: 600;
    color: var(--mute);
  }
  .ct-name {
    font-family: var(--display);
    font-size: clamp(26px, 3.6vw, 52px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    transition:
      color 0.3s,
      transform 0.6s var(--ease-expo);
  }
  .ct-link:hover .ct-name {
    color: var(--blue);
    transform: translateX(10px);
  }
  .ct-meta {
    font-size: 14px;
    font-weight: 600;
    color: var(--mute-2);
  }
  .ct-pic {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--ink);
  }
  .ct-pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ct-frame {
    width: clamp(280px, 30vw, 440px);
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .ct-bar {
    display: block;
    height: 28px;
    padding: 0 12px;
    border-bottom: 1px solid var(--ink);
    background: var(--paper-2);
    font-size: 12px;
    font-weight: 600;
    line-height: 28px;
    text-align: center;
    color: var(--mute-2);
  }
  .ct-view {
    aspect-ratio: 16 / 10;
    background: var(--paper-3);
  }
  @media (max-width: 1024px) {
    .ct-link {
      grid-template-columns: 36px minmax(0, 1fr) 96px;
    }
    .ct-meta {
      grid-column: 2;
      grid-row: 2;
    }
    .ct-pic {
      grid-column: 3;
      grid-row: 1 / span 2;
    }
  }
</style>
